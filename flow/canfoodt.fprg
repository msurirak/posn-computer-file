        <attribute name="edited" value="Q29tMTExO0RFU0tUT1AtQjhMSlRGQTsyNTY4LTAzLTEyOzAxOjEyOjU1IFBNOzQ7MjkwNA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="x" type="Integer" array="False" size=""/>
            <declare name="y" type="Integer" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="r" type="Integer" array="False" size=""/>
            <declare name="e" type="Integer" array="False" size=""/>
            <assign variable="r" expression="0"/>
            <input variable="e"/>
            <for variable="i" start="1" end="e" direction="inc" step="1">
                <input variable="y"/>
                <input variable="x"/>
                <if expression="x&gt;=150&amp;&amp;x&lt;=200&amp;&amp;y&lt;=400">
                    <then>
                        <assign variable="r" expression="r + 1"/>
                    </then>
                    <else/>
                </if>
            </for>
            <output expression="r" newline="True"/>
        </body>
    </function>
</flowgorithm>
