<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="trinangle"/>
        <attribute name="authors" value="KKK"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2567-10-15 03:39:24 PM"/>
        <attribute name="created" value="S0tLO0RFU0tUT1AtQjZQOEFJVTsyNTY3LTEwLTE1OzAyOjUyOjM3IFBNOzI1Nzc="/>
        <attribute name="edited" value="S0tLO0RFU0tUT1AtQjZQOEFJVTsyNTY3LTEwLTE1OzAzOjM5OjI0IFBNOzE7MjY4Nw=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c, q, w, e, r" type="Integer" array="False" size=""/>
            <input variable="a"/>
            <input variable="b"/>
            <input variable="c"/>
            <if expression="a=b &amp;&amp; b=c">
                <then>
                    <output expression="&quot;Equileterel trdfsdf&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="a&gt;b">
                        <then>
                            <if expression="a&gt;c">
                                <then>
                                    <output expression="&quot;a&quot;" newline="True"/>
                                    <assign variable="q" expression="a"/>
                                    <assign variable="w" expression="b"/>
                                    <assign variable="e" expression="c"/>
                                </then>
                                <else>
                                    <output expression="&quot;c&quot;" newline="True"/>
                                    <assign variable="q" expression="c"/>
                                    <assign variable="w" expression="b"/>
                                    <assign variable="e" expression="a"/>
                                </else>
                            </if>
                        </then>
                        <else>
                            <if expression="b&gt;c">
                                <then>
                                    <output expression="&quot;b&quot;" newline="True"/>
                                    <assign variable="q" expression="b"/>
                                    <assign variable="w" expression="a"/>
                                    <assign variable="e" expression="c"/>
                                </then>
                                <else>
                                    <output expression="&quot;c&quot;" newline="False"/>
                                    <assign variable="q" expression="c"/>
                                    <assign variable="w" expression="b"/>
                                    <assign variable="e" expression="a"/>
                                </else>
                            </if>
                        </else>
                    </if>
                    <output expression="q" newline="True"/>
                    <output expression="w" newline="True"/>
                    <output expression="e" newline="True"/>
                    <if expression="q&lt;w+e">
                        <then>
                            <assign variable="r" expression="0"/>
                            <if expression="q=w">
                                <then>
                                    <output expression="&quot;isoseles trisdlflklo &quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="w=e">
                                        <then>
                                            <output expression="&quot;isoseles trisdlflklo &quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <if expression="r=1">
                                                <then>
                                                    <output expression="&quot;a trikn ksdnf&quot;" newline="True"/>
                                                </then>
                                                <else>
                                                    <output expression="&quot;Sealena teriiert&quot;" newline="True"/>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </then>
                        <else>
                            <output expression="&quot;Not trridb&quot;" newline="True"/>
                            <assign variable="r" expression="1"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
